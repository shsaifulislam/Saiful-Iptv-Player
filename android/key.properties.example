# Template for Android Release Signing
# DO NOT COMMIT THE ACTUAL key.properties OR KEYSTORE FILES TO SOURCE CONTROL!
# Copy this file to key.properties and replace with your verified production values.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=saiful_iptv_release_key
storeFile=/path/to/upload-keystore.jks

